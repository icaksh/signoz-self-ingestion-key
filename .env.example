SIGNOZ_ENDPOINT=http://localhost:4318
SIGNOZ_INGESTION_KEY=cinnabar #optional, delete if not needed
PROXY_PORT=4318
ADMIN_PORT=8080
# SESSION_SIGNING_KEY is REQUIRED — generate: openssl rand -hex 32
SESSION_SIGNING_KEY=
# ADMIN_COOKIE_SECURE=true
# ADMIN_LISTEN_ADDR=127.0.0.1:8080
# MAX_BODY_BYTES=4194304
USAGE_RETENTION_DAYS=90

# Syslog-over-TLS (mTLS) — optional, disabled by default
# SYSLOG_ENABLED=true
# SYSLOG_LISTEN_ADDR=:6514
# SYSLOG_SERVER_CERT_FILE=/etc/ssl/proxy/server.crt
# SYSLOG_SERVER_KEY_FILE=/etc/ssl/proxy/server.key
# SYSLOG_CLIENT_CA_FILE=/etc/ssl/proxy/client-ca.crt
# SYSLOG_MAX_FRAME_BYTES=65536
# SYSLOG_MAX_CONNECTIONS=1000
# SYSLOG_CONN_IDLE_TIMEOUT=300s
# SYSLOG_COLLECTOR_ADDR=127.0.0.1:5140

# Certificate lifecycle (step-ca) — optional, disabled by default.
# Full guide: CA_ENABLEMENT.md
# CA_ENABLED=true
# CA_ENDPOINT=https://step-ca:9000
# CA_PROVISIONER_NAME=otlp-proxy
# CA_PROVISIONER_KEY_FILE=/etc/otlp-proxy/provisioner.jwk  # or inline CA_PROVISIONER_KEY="{...}"
# CA_ROOT_CERT_FILE=/etc/otlp-proxy/root_ca.crt
# CA_EXTERNAL_HOSTNAME=relay.example.com
# CA_CERT_LIFETIME=2160h
# CA_RENEWAL_LISTEN_ADDR=:6543
# CA_SYSLOG_RELAY_PORT=6514
