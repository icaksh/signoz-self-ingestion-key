SIGNOZ_ENDPOINT=http://localhost:4318
SIGNOZ_INGESTION_KEY=  # optional, delete or leave blank if not needed
PROXY_PORT=4318
ADMIN_PORT=8080
DB_PATH=./tenants.db
# SESSION_SIGNING_KEY is REQUIRED — generate: openssl rand -hex 32
SESSION_SIGNING_KEY=
# ADMIN_COOKIE_SECURE=true          # set false for local dev over plain HTTP
# ADMIN_LISTEN_ADDR=127.0.0.1:8080  # use 0.0.0.0:8080 for Docker
# MAX_BODY_BYTES=4194304
USAGE_RETENTION_DAYS=90

# ---------------------------------------------------------------------------
# Syslog-over-TLS (mTLS) — optional, disabled by default
#
# When enabled the proxy listens on a dedicated TLS port for syslog clients.
# Each client must present a certificate issued by the admin-certificate
# workflow (or manually enrolled) and every frame is rate-limited per-tenant.
# ---------------------------------------------------------------------------
# SYSLOG_ENABLED=true
# SYSLOG_LISTEN_ADDR=:6514
# SYSLOG_SERVER_CERT_FILE=/etc/ssl/proxy/server.crt
# SYSLOG_SERVER_KEY_FILE=/etc/ssl/proxy/server.key
# SYSLOG_CLIENT_CA_FILE=/etc/ssl/proxy/client-ca.crt       # CA bundle for client mTLS
# SYSLOG_MAX_FRAME_BYTES=65536
# SYSLOG_MAX_CONNECTIONS=1000
# SYSLOG_MAX_CONNS_PER_TENANT=50   # per-tenant connection cap (backpressure)
# SYSLOG_CONN_IDLE_TIMEOUT=300s
# SYSLOG_COLLECTOR_ADDR=127.0.0.1:5140  # upstream OTLP collector accepting syslog

# ---------------------------------------------------------------------------
# Certificate lifecycle management (step-ca) — optional, disabled by default
#
# Full guide: CA_ENABLEMENT.md
#
# When enabled the admin UI gains certificate issuance, renewal and revocation.
# The proxy uses the step-ca API to create short-lived client certificates
# that syslog clients use for mTLS authentication.
#
# Prerequisites:
#   1. A running step-ca instance (step-ca serve)
#   2. A provisioner created for this proxy (step ca provisioner add otlp-proxy --type JWK)
#   3. The root CA certificate (step ca root or step ca certificate root_ca.crt)
#
# Provisioner credentials are provided via a JWK file OR inline JSON:
#   CA_PROVISIONER_KEY_FILE — path to the JWK private key file
#   CA_PROVISIONER_KEY       — inline JSON for the JWK (mutually exclusive with the file)
# ---------------------------------------------------------------------------
# CA_ENABLED=true
# CA_ENDPOINT=https://step-ca:9000
# CA_PROVISIONER_NAME=otlp-proxy
# CA_PROVISIONER_KEY_FILE=/etc/otlp-proxy/provisioner.jwk
# CA_PROVISIONER_KEY={"use":"sig","kty":"EC","kid":"...","crv":"P-256","alg":"ES256","x":"...","y":"...","d":"..."}
# CA_ROOT_CERT_FILE=/etc/otlp-proxy/root_ca.crt
# CA_EXTERNAL_HOSTNAME=relay.example.com   # public hostname clients connect to
# CA_CERT_LIFETIME=2160h                   # 90 days — max cert validity
# CA_RENEWAL_LISTEN_ADDR=:6543             # renewal callback listener
# CA_SYSLOG_RELAY_PORT=6514                # syslog relay port embedded in issued certs
