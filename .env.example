# Upstream telemetry destination
SIGNOZ_ENDPOINT=http://signoz:4318
SIGNOZ_INGESTION_KEY=

# Browser/admin security
SESSION_SIGNING_KEY=REPLACE_WITH_64_HEX_CHARS
ADMIN_COOKIE_SECURE=false
TRUST_PROXY_HEADERS=false
MAX_BODY_BYTES=4194304
USAGE_RETENTION_DAYS=90

# Host exposure
PROXY_BIND=0.0.0.0
PROXY_PORT=4318
ADMIN_BIND=127.0.0.1
ADMIN_PORT=8080
SYSLOG_BIND=0.0.0.0
SYSLOG_PORT=6514
CA_RENEWAL_BIND=0.0.0.0
CA_RENEWAL_PORT=6543

# Bundled step-ca
STEP_CA_IMAGE=smallstep/step-ca:0.30.2
STEP_CA_BIND=127.0.0.1
STEP_CA_PORT=9000
STEP_CA_NAME=OTLP Proxy CA
STEP_CA_DNS_NAMES=step-ca,localhost,127.0.0.1
CA_PROVISIONER_NAME=otlp-proxy
CA_EXTERNAL_HOSTNAME=relay.example.com
CA_CERT_LIFETIME=2160h

# Bundled syslog conversion collector
OTELCOL_IMAGE=otel/opentelemetry-collector-contrib:0.157.0

# Optional syslog mTLS ingestion
SYSLOG_ENABLED=false
SYSLOG_COLLECTOR_ADDR=syslog-collector:5140
SYSLOG_MAX_FRAME_BYTES=65536
SYSLOG_MAX_CONNECTIONS=1000
SYSLOG_MAX_CONNS_PER_TENANT=50
SYSLOG_CONN_IDLE_TIMEOUT=300s
